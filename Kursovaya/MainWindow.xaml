<Window x:Class="Kursovaya.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="700" Width="1000"  Title="MasterPiece"
        Background="#F8F9FA">


    <TabControl TabStripPlacement="Left" Background="Transparent" BorderThickness="0">
      
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border Name="Border" Padding="15,12" Margin="0,5" Background="Transparent" BorderThickness="0" CornerRadius="8">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Left"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#EEF2FF"/>
                                    <Setter Property="Foreground" Value="#4F46E5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter Property="Foreground" Value="#4B5563"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.Resources>

        <!-- Вкладка 1: Трекер (Дневник) -->
        <TabItem Header="📊  Трекер">
        
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="30">
                <StackPanel>
                   
                    <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,25">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ваш дневник обучения" FontSize="20" FontWeight="SemiBold" Foreground="#1F2937"/>
                                <TextBlock Text="Здесь отображаются все ваши сыгранные сессии" FontSize="13" Foreground="#9CA3AF" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button x:Name="btnOpenNewSession" Click="btnOpenNewSession_Click" Grid.Column="1" Content="+ Новая сессия" Background="#6366F1" Foreground="White" FontSize="16" FontWeight="SemiBold" Padding="25,12" BorderThickness="0" Cursor="Hand"/>


                        </Grid>
                    </Border>
                   
                    <TextBlock Text="История сессий" FontSize="18" FontWeight="Bold" Foreground="#374151" Margin="5,0,0,15"/>
                  
                    <StackPanel x:Name="SessionsList">
                     
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Вкладка 2: Библиотека -->
        <TabItem Header="📚  Библиотека">
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
              
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Библиотека произведений" FontSize="20" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Name="AddPieceBtn" Click="AddPieceBtn_Click" Content="+ Добавить" Background="#6366F1" Foreground="White" Padding="25,12" BorderThickness="0" Cursor="Hand" />

                    </Grid>
                </Border>
               
               
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="PiecesPanel">
                       
                    </WrapPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- Вкладка 3: Тюнер -->
        <TabItem Header="🎸  Тюнер">
            <TextBlock Text="Тюнер в разработке..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="Gray"/>
        </TabItem>

        <!-- Вкладка 4: Профиль -->
        <TabItem Header="🏆  Профиль">
            <TextBlock Text="Профиль в разработке..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="Gray"/>
        </TabItem>
        <!-- Вкладка 5: О проекте -->
        <TabItem Header="ℹ️  О проекте">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="40">
                <StackPanel>
                    <TextBlock Text="О проекте MasterPiece" FontSize="24" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,20"/>

                    <TextBlock Text="Автор:Горбунова Ольга Васильевна" Foreground="#374151" Margin="0,0,0,5"/>
                    <TextBlock Text="Преподаватель: Егурнова Елена Николаевна" Foreground="#374151" Margin="0,0,0,5"/>
                    <TextBlock Text="Стек: C#, WPF, Entity Framework Core (MSSQL), NAudio, MathNet.Numerics, iTunes Search API." Foreground="#374151" Margin="0,0,0,5"/>
                    <TextBlock Text="Паттерны: Фасад (Facade) — для работы с БД; Стратегия (Strategy) — для тюнера." Foreground="#374151" Margin="0,0,0,5"/>
                    <TextBlock Text="© 2026 MasterPiece. Курсовой проект." HorizontalAlignment="Center" Foreground="#9CA3AF" Margin="0,20,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>