<Window x:Class="Kursovaya.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="700" Width="1000"
        Background="#F8F9FA">

    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <!-- Меню -->
            <ColumnDefinition Width="*"/>
            <!-- Контент -->
        </Grid.ColumnDefinitions>

        <!--  ЛЕВОЕ МЕНЮ  -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" >
            <StackPanel Margin="15,30,15,15">
                <TextBlock Text="MasterPiece" FontSize="22" FontWeight="Bold" Foreground="#4F46E5" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <Button Content="📊  Трекер" Background="#EEF2FF" Foreground="#4F46E5" FontSize="15" FontWeight="SemiBold" Padding="15,12" Margin="0,5" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand"/>
                <Button Content="🎸  Тюнер" Background="Transparent" Foreground="#4B5563" FontSize="15" Padding="15,12" Margin="0,5" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand"/>
                <Button Content="📚  Библиотека" Background="Transparent" Foreground="#4B5563" FontSize="15" Padding="15,12" Margin="0,5" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand"/>
                <Button Content="🏆  Профиль" Background="Transparent" Foreground="#4B5563" FontSize="15" Padding="15,12" Margin="0,5" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ  -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">

                <!-- ШАПКА -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect Color="#E5E7EB" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ваш дневник обучения" FontSize="20" FontWeight="SemiBold" Foreground="#1F2937"/>
                            <TextBlock Text="Здесь отображаются все ваши сыгранные сессии" FontSize="13" Foreground="#9CA3AF" Margin="0,5,0,0"/>
                        </StackPanel>

                        <Button x:Name="btnOpenNewSession" Grid.Column="1" Content="+ Новая сессия" Background="#6366F1" Foreground="White" FontSize="16" FontWeight="SemiBold" Padding="25,12" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- ЗАГОЛОВОК СПИСКА -->
                <TextBlock Text="История сессий" FontSize="18" FontWeight="Bold" Foreground="#374151" Margin="5,0,0,15"/>

                <!-- СПИСОК КАРТОЧЕК -->
                <StackPanel x:Name="SessionsList">
                    <!-- Одна карточка-заглушка -->
                    <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                        <Border.Effect>
                            <DropShadowEffect Color="#F3F4F6" BlurRadius="5" ShadowDepth="1" Opacity="0.8"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Moonlight Sonata" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Сегодня • 14:30 - 15:15" FontSize="13" Foreground="#6B7280"/>
                                    <Ellipse Width="4" Height="4" Fill="#D1D5DB" Margin="10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Классика" FontSize="13" Foreground="#6B7280"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="00:45:00" FontSize="16" FontWeight="Bold" Foreground="#4F46E5" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>